# ITS Digital Twin - Environment Configuration Template
# For Vercel / Cloudflare / GitHub Pages deployment:
# Set VITE_MAPBOX_TOKEN in your platform's Project Settings > Environment Variables

# Mapbox Public Access Token (pk.eyJ1...)
VITE_MAPBOX_TOKEN=pk.eyJ1IjoieW91cnVzZXJuYW1lIiwiYSI6InlvdXJ0b2tlbiJ9...

# Backend API Base URL (optional - leave empty or unset for static deployment)
VITE_API_BASE_URL=http://localhost:8000/api

# Static Mode (set to true for standalone Vercel / Cloudflare hosting without FastAPI backend)
VITE_STATIC_MODE=false
